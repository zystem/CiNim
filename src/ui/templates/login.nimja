{% extends "layout.nimja" %}
{% block title %}Log in - CiNim{% endblock %}
{% block content %}<h1>Log in</h1>
{% if message.len > 0 %}<p class="error" role="alert">{{ h(message) }}</p>{% endif %}
<form method="post" action="{{ h(base) }}/login" class="login">
<label>User <input type="text" name="user" value="{{ h(user) }}" autocomplete="username" required autofocus></label>
<label>Password <input type="password" name="password" autocomplete="current-password" required></label>
<input type="hidden" name="next" value="{{ h(next) }}">
<button type="submit">Log in</button>
</form>{% endblock %}
