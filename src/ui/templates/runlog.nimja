{% extends "layout.nimja" %}
{% block title %}Log of run {{ h(runId) }} - CiNim{% endblock %}
{% block content %}<h1>Log of run <code>{{ h(runId) }}</code></h1>
<p><a href="{{ h(base) }}/runs/{{ h(runId) }}">Run <code>{{ h(runId) }}</code></a> - state: <span class="state-{{ h(runState) }}">{{ h(runState) }}</span> - one window: every line starts with its step (the job and the step), in the order of the steps</p>
<p class="pager">{% if earlier.len > 0 %}<a href="{{ h(earlier) }}">Earlier lines</a>{% endif %}{% if later.len > 0 %} <a href="{{ h(later) }}">Later lines</a>{% endif %}{% if newest.len > 0 %} <a href="{{ h(newest) }}">Newest</a>{% endif %}</p>
<pre class="log">{% for l in lines %}<a class="n" href="{{ h(base) }}/runs/{{ h(runId) }}/steps/{{ h(l.step) }}/log?from={{ h(l.ln) }}">{{ h(l.label) }}</a> {{ h(l.text) }}
{% endfor %}</pre>
{% if lines.len == 0 %}<p class="empty">No lines in this window.</p>{% endif %}{% endblock %}
