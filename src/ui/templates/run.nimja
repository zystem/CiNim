{% extends "layout.nimja" %}
{% block title %}Run {{ h(run.id) }} - CiNim{% endblock %}
{% block content %}<h1>Run <code>{{ h(run.id) }}</code></h1>
<dl class="facts">
<dt>State</dt><dd class="state-{{ h(run.state) }}">{{ h(run.state) }}</dd>
<dt>Organisation</dt><dd>{% if run.organization.len > 0 %}<a href="{{ h(base) }}/orgs/{{ h(run.organization) }}/runs">{{ h(run.organization) }}</a>{% endif %}</dd>
{% if run.group.len > 0 %}<dt>Group</dt><dd>{{ h(run.group) }}</dd>{% endif %}
<dt>Started</dt><dd>{{ h(run.created) }}</dd><dt>Updated</dt><dd>{{ h(run.updated) }}</dd>
{% if run.repository.len > 0 %}<dt>Source</dt><dd>{{ h(run.repository) }} @ <code>{{ h(run.commit) }}</code> {{ h(run.path) }}</dd>{% endif %}
{% if run.waitReason.len > 0 %}<dt>Waiting</dt><dd>{{ h(run.waitReason) }}</dd>{% endif %}
{% if run.failureCode.len > 0 %}<dt>Failure</dt><dd class="error"><code>{{ h(run.failureCode) }}</code> {{ h(run.failureMessage) }}</dd>{% endif %}
</dl>
{% if run.params.len > 0 %}<h2>Parameters</h2><table><tbody>{% for p in run.params %}<tr><th>{{ h(p.name) }}</th><td>{{ h(p.value) }}</td></tr>{% endfor %}</tbody></table>{% endif %}
<h2>Steps</h2>
<table><thead><tr><th>Step</th><th>Attempt</th><th>State</th><th>Exit</th><th>Ended as</th><th>Pod</th><th>Log</th></tr></thead><tbody>
{% for s in run.steps %}<tr id="step-{{ h(s.seq) }}"><td>{{ h(s.seq) }}</td><td>{{ h(s.attempt) }}</td><td class="state-{{ h(s.state) }}">{{ h(s.state) }}</td><td>{{ h(s.exitCode) }}</td><td>{{ h(s.termination) }}</td><td>{{ h(s.pod) }}</td><td><a href="{{ h(base) }}/runs/{{ h(run.id) }}/steps/{{ h(s.seq) }}/log">log</a></td></tr>
{% endfor %}</tbody></table>
{% if run.steps.len == 0 %}<p class="empty">No steps yet.</p>{% endif %}{% endblock %}
