{% extends "layout.nimja" %}
{% block title %}Registries - CiNim{% endblock %}
{% block content %}<h1>Image registries: {{ h(org) }}</h1>
<p><a href="{{ h(base) }}/orgs">Organisations</a> - <a href="{{ h(base) }}/orgs/{{ h(org) }}/members">Members</a> - <a href="{{ h(base) }}/orgs/{{ h(org) }}/teams">Teams</a> - <a href="{{ h(base) }}/orgs/{{ h(org) }}/projects">Projects</a> - <a href="{{ h(base) }}/orgs/{{ h(org) }}/deploy-profiles">Deploy profiles</a> - <a href="{{ h(base) }}/roles">Roles</a></p>
<p class="detail">A registry is where the pipelines of <b>{{ h(org) }}</b> push their images, found by name. The address is what the images are called under (<code>&lt;address&gt;/&lt;image&gt;</code>); the password is kept sealed and is never shown again.</p>
<table><thead><tr><th>Name</th><th>Address</th><th>Connection</th><th>Login</th><th>Description</th>{% if canWrite %}<th></th>{% endif %}</tr></thead><tbody>
{% for r in registries %}<tr id="registry-{{ h(r.name) }}"><td><code>{{ h(r.name) }}</code></td><td>{{ h(r.address) }}</td><td>{% if r.insecure %}plain HTTP, or no certificate to check{% else %}TLS{% endif %}</td><td>{% if r.hasPassword %}login of {{ h(r.username) }}{% else %}no login{% endif %}</td><td>{{ h(r.description) }}</td>
{% if canWrite %}<td><form method="post" action="{{ h(here) }}/{{ h(r.name) }}/delete" class="inline"><button type="submit">Remove</button></form></td>{% endif %}</tr>
{% endfor %}</tbody></table>
{% if registries.len == 0 %}<p class="empty">This organisation has no registry.</p>{% endif %}
{% if canWrite %}<h2>Add a registry, or change one (the same name)</h2>
<form method="post" action="{{ h(here) }}/save" class="stack">
<label>Name <input type="text" name="name" required maxlength="40" pattern="[a-z][a-z0-9_-]*" placeholder="gh"></label>
<label>Address <input type="text" name="address" required maxlength="200" placeholder="ghcr.io/acme"></label>
<label><input type="checkbox" name="insecure" value="1"> Plain HTTP, or a certificate that cannot be checked (the registry of the cluster)</label>
<label>User <input type="text" name="username" maxlength="200" autocomplete="off"></label>
<label>Password or token <input type="password" name="password" maxlength="4096" autocomplete="new-password"></label>
<label><input type="checkbox" name="remove_login" value="1"> Take the login away (when changing a registry; an empty password keeps the old one)</label>
<label>Description <input type="text" name="description" maxlength="300"></label>
<div class="actions"><button type="submit">Save</button></div></form>{% endif %}{% endblock %}
