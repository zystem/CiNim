# the image of an HTTP store node (docs/store.md, D-58): Caddy with the WebDAV module of the CiNim fork. `CADDY_WEBDAV_REF` is the branch or tag of github.com/zystem/caddy-webdav.
# Build it with COMPONENTS=caddy-store:cinim-store-dav (tools/image/kaniko-build.sh); it needs no image of the libraries; it needs the network of the build Pod for the Go modules.
FROM caddy:2-builder AS caddy-build
ARG CADDY_WEBDAV_REF=cinim-store
# no file capability on the binary (xcaddy would set cap_net_bind_service and then fail to run it in a build Pod without that capability); the node listens on 8080
ENV XCADDY_SETCAP=0
RUN xcaddy build --with github.com/zystem/caddy-webdav@${CADDY_WEBDAV_REF} --output /caddy-store
FROM caddy:2
COPY --from=caddy-build /caddy-store /usr/bin/caddy
USER 65532:65532
EXPOSE 8080

