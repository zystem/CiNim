# The emulator of the key service (tools/kekd-emu): for developing and testing the core without a card. NOT for production. Built from the image of the libraries
# (`--build-arg DEPS_IMAGE=`, tools/image/Dockerfile.deps).
ARG DEPS_IMAGE
FROM ${DEPS_IMAGE} AS build
COPY . /src
WORKDIR /src
RUN set -eu; mkdir -p /out; tools/image/build-static.sh /out/kekd-emu tools/kekd-emu/main.nim -d:ssl -d:useOpenssl3 --dynlibOverride:ssl --dynlibOverride:crypto --passL:"-L/opt/zmq/lib -lsodium -lssl -lcrypto -lm"; strip /out/*

FROM scratch
COPY --from=build /out/kekd-emu /kekd-emu
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/kekd-emu"]
