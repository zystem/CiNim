# The image the tests run in (the pipeline of the repository, .ci/pipeline.lua): Nim on glibc like the workstation (the tests that use threads end in a crash on musl, so the Alpine image of the
# libraries is not used), the system libraries the tests link (libzmq, libsodium, libpcre, sqlite, OpenSSL), the nimble packages, git, curl and the openssl command (the certificates of the TLS test of the key service), and
# `rqlited`, so that the integration tests start their own scratch databases without Docker (tools/test/run.sh with CINIM_RQLITE_BIN). Built with the repository as the context; the hash of the
# image is that of this file and cinim.nimble. It holds the real key service, hsmgate (github.com/zystem/hsmgate), built from the tag HSMGATE_REF with the Go of the project (the base is pinned
# as the project pins it): the tests thsmgate.nim, thsmgate_tls.nim and tkeyservice.nim run against it when HSMGATE_BIN is set, which the image does (they are skipped on a machine without it).
# A new version of hsmgate is a change of this ARG: the image is made again, and the tests say whether the core still speaks with it.
FROM golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c AS hsmgate
ARG HSMGATE_REF=v0.1.6
RUN git clone -q --depth 1 --branch "${HSMGATE_REF}" https://github.com/zystem/hsmgate.git /src \
 && cd /src && CGO_ENABLED=1 go build -trimpath -buildvcs=false -ldflags "-s -w -X main.version=${HSMGATE_REF}" -o /out/hsmgate ./cmd/hsmgate

FROM nimlang/nim:2.2.12
RUN apt-get update && apt-get install -y --no-install-recommends bash build-essential ca-certificates curl git procps openssl \
      libzmq3-dev libsodium-dev libpcre3-dev libsqlite3-dev libssl-dev && rm -rf /var/lib/apt/lists/*
# rqlited for glibc: the release of the project (the one in its image is built for musl)
RUN curl -fsSL https://github.com/rqlite/rqlite/releases/download/v10.5.1/rqlite-v10.5.1-linux-amd64.tar.gz | tar xz -C /tmp \
 && install -m 0755 /tmp/rqlite-v10.5.1-linux-amd64/rqlited /usr/local/bin/rqlited && rm -rf /tmp/rqlite-v10.5.1-linux-amd64
# the nimble packages, from the package file alone so that this layer is cached
COPY cinim.nimble /src/cinim.nimble
RUN cd /src && nimble install -y --depsOnly
COPY --from=hsmgate /out/hsmgate /usr/local/bin/hsmgate
ENV HSMGATE_BIN=/usr/local/bin/hsmgate
