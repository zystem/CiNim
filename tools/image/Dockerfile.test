# The image the tests run in (the pipeline of the repository, .ci/pipeline.lua): Nim on glibc like the workstation (the tests that use threads end in a crash on musl, so the Alpine image of the
# libraries is not used), the system libraries the tests link (libzmq, libsodium, libpcre, sqlite, OpenSSL), the nimble packages, git, curl and Python (the key-service emulator's tests), and
# `rqlited`, so that the integration tests start their own scratch databases without Docker (tools/test/run.sh with CINIM_RQLITE_BIN). Built with the repository as the context; the hash of the
# image is that of this file and cinim.nimble.
FROM nimlang/nim:2.2.4
RUN apt-get update && apt-get install -y --no-install-recommends bash build-essential ca-certificates curl git procps python3 python3-cryptography \
      libzmq3-dev libsodium-dev libpcre3-dev libsqlite3-dev libssl-dev && rm -rf /var/lib/apt/lists/*
# rqlited for glibc: the release of the project (the one in its image is built for musl)
RUN curl -fsSL https://github.com/rqlite/rqlite/releases/download/v10.5.1/rqlite-v10.5.1-linux-amd64.tar.gz | tar xz -C /tmp \
 && install -m 0755 /tmp/rqlite-v10.5.1-linux-amd64/rqlited /usr/local/bin/rqlited && rm -rf /tmp/rqlite-v10.5.1-linux-amd64
# the nimble packages, from the package file alone so that this layer is cached
COPY cinim.nimble /src/cinim.nimble
RUN cd /src && nimble install -y --depsOnly
