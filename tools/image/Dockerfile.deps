# The libraries every binary of the platform is built with (libsodium, nghttp2, the Kubernetes C client, the nimble packages), as one image: `cinim-deps:<hash>`, made once
# (tools/image/kaniko-build.sh, deploy/examples/self-build, tools/image/build-local.sh) and named by the components' Dockerfiles with `--build-arg DEPS_IMAGE=`. The hash is
# that of this file, cinim.nimble, cinim.lock and tools/k8s/build_client.sh: the four things the image is made of.
# Nim 2.4.0 on Alpine, made by github.com/zystem/nim-alpine (the official Alpine images stopped at 2.2.6, whose httpclient is wrong for https through a proxy: see CLAUDE.md)
FROM ghcr.io/zystem/nim:2.4.0-alpine@sha256:3c12111aec6f5dcc5e5b425cb1b1a81f37435d4ef1d84fa45d6e45aae55b8295
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
RUN apk add --no-cache bash coreutils upx g++ make cmake git autoconf automake libtool linux-headers curl openssl-dev openssl-libs-static \
    zlib-dev zlib-static sqlite-dev sqlite-static ca-certificates xz
# libsodium as a static archive (the sealing of the secrets, common/sodiumaead.nim)
# libsodium 1.0.20-RELEASE, by its commit (the commit of the tag, `git ls-remote <url> 1.0.20-RELEASE` shows it on the line that ends with ^{}): a tag can be moved
# the build is in a directory of its own that goes in the same layer (WORKDIR would leave the sources in a layer): hence the cd
# hadolint ignore=DL3003
RUN set -eu; W=$(mktemp -d); cd "$W"; \
    git init -q sodium; git -C sodium fetch -q --depth 1 https://github.com/jedisct1/libsodium 9511c982fb1d046470a8b42aa36556cdb7da15de; git -C sodium checkout -q FETCH_HEAD; test "$(git -C sodium rev-parse HEAD)" = 9511c982fb1d046470a8b42aa36556cdb7da15de; \
    (cd sodium && ./autogen.sh >/dev/null 2>&1 && ./configure --prefix=/opt/sodium --disable-shared --enable-static --enable-minimal >/dev/null && make -j"$(nproc)" install >/dev/null); \
    rm -rf "$W"
# nghttp2 as a static archive, where nimgrpc looks for it by default (the shim's gRPC channels, docs/shim-grpc.md); 1.61 or later is required
# renovate: datasource=github-releases depName=nghttp2/nghttp2 extractVersion=^v(?<version>.+)$
ARG NGHTTP2_VERSION=1.71.0
# the SHA-256 of that tarball (GitHub shows it for the release asset): a new version needs a new sum, and a build that has the old one stops at the check
ARG NGHTTP2_SHA256=c0f55121d88650e4b9227aec28cebaf664d2417ca60fe70be0f8d38829f52116
RUN set -eu; W=$(mktemp -d); \
    curl -fsSL -o "$W/nghttp2.tar.xz" "https://github.com/nghttp2/nghttp2/releases/download/v${NGHTTP2_VERSION}/nghttp2-${NGHTTP2_VERSION}.tar.xz"; \
    echo "${NGHTTP2_SHA256}  $W/nghttp2.tar.xz" | sha256sum -c -; \
    tar xJf "$W/nghttp2.tar.xz" -C "$W"; \
    cmake -S "$W/nghttp2-${NGHTTP2_VERSION}" -B "$W/b" -DENABLE_LIB_ONLY=ON -DBUILD_SHARED_LIBS=OFF -DBUILD_STATIC_LIBS=ON -DCMAKE_BUILD_TYPE=MinSizeRel \
      -DCMAKE_INSTALL_PREFIX=/opt/nghttp2 -DCMAKE_C_FLAGS="-ffunction-sections -fdata-sections" >/dev/null; \
    cmake --build "$W/b" -j"$(nproc)" --target install >/dev/null; rm -rf "$W"; test -f /opt/nghttp2/lib/libnghttp2.a
# the Kubernetes C client with libcurl, libwebsockets, libyaml (static)
COPY tools/k8s/build_client.sh /src/tools/k8s/build_client.sh
RUN K8S_STATIC=1 /src/tools/k8s/build_client.sh /opt/k8s >/dev/null
# the nimble packages, in the versions of cinim.lock (made by tools/deps/lock.sh; named by --lockFile), from the two files alone so that this layer is cached
WORKDIR /src
COPY cinim.nimble cinim.lock ./
RUN nimble install -y --depsOnly --lockFile=cinim.lock
WORKDIR /app
