{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["shard", "mode", "domain", "basePath", "namespacePrefix", "image", "curve"],
  "properties": {
    "shard": {"type": "string", "pattern": "^[0-9]{1,16}$"},
    "mode": {"enum": ["single", "multi"]},
    "domain": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
    "basePath": {"type": "string", "pattern": "^/([-a-zA-Z0-9._~/]*)$"},
    "namespacePrefix": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,28}[a-z0-9])?$"},
    "publicUrl": {"type": "string", "pattern": "^(https?://.+)?$"},
    "routerUrl": {"type": "string", "pattern": "^(https?://.+)?$"},
    "routerKey": {"type": "string"},
    "routerInterval": {"type": "integer", "minimum": 10},
    "image": {"type": "object", "required": ["repository"], "properties": {"repository": {"type": "string", "minLength": 1}}},
    "curve": {"type": "object", "required": ["secretName"], "properties": {"secretName": {"type": "string", "minLength": 1}}},
    "rqliteUrl": {"type": "string", "pattern": "^(https?://.+)?$"},
    "storage": {"type": "object", "properties": {"url": {"type": "string", "pattern": "^(https?://.+)?$"}, "directUrl": {"type": "string", "pattern": "^(https?://.+)?$"}, "tokenSecret": {"type": "object", "properties": {"name": {"type": "string"}, "key": {"type": "string"}}}}},
    "logs": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "victoriaLogsUrls": {"type": "array", "items": {"type": "string"}}, "vlagentUrl": {"type": "string"}}},
    "metrics": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "monitor": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "operator": {"enum": ["prometheus", "victoriametrics"]}, "interval": {"type": "string"}}}}},
    "build": {"type": "object", "properties": {"enabled": {"type": "boolean"},
              "internet": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
                           "except": {"type": "array", "items": {"type": "string"}}}},
              "egress": {"oneOf": [{"type": "array", "items": {"type": "object"}}, {"const": "all"}]},
              "seccompProfile": {"enum": ["RuntimeDefault", "Localhost"]},
              "ingress": {"oneOf": [{"type": "array", "items": {"type": "object"}}, {"const": "all"}]},
              "capabilities": {"type": "array", "items": {"enum": ["CHOWN", "DAC_OVERRIDE", "FOWNER", "SETFCAP", "SETGID", "SETUID"]}},
              "memoryLimit": {"type": "string"}, "ephemeralStorageLimit": {"type": "string"}}},
    "secrets": {"type": "object", "properties": {"keySecret": {"type": "string"}, "kekd": {"type": "object", "properties": {"url": {"type": "string"}, "tlsSecret": {"type": "string"}}}}},
    "auth": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "adminToken": {"type": "string"}, "adminTokenSecret": {"type": "string"}}},
    "steps": {"type": "object", "properties": {"ephemeralStorageLimit": {"type": "string"}}},
    "deploy": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "kubeApiServer": {"type": "boolean"}, "egress": {"type": ["array", "string"]}}},
    "cache": {"type": "object", "properties": {"quota": {"type": "integer"}, "retention": {"type": "integer"}}},
    "artifacts": {"type": "object", "properties": {"retention": {"type": "integer"}, "abandonAfter": {"type": "integer"}}},
    "runStorage": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "size": {"type": "string"}, "storageClass": {"type": "string"},
      "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]},
      "retention": {"type": "object", "properties": {"succeeded": {"type": "integer"}, "failed": {"type": "integer"}, "pressure": {"type": "integer"}}}}},
    "organizations": {"type": "object", "properties": {"reconcileInterval": {"type": "integer", "minimum": 10}, "retention": {"type": "integer", "minimum": -1}, "purgeGrace": {"type": "integer", "minimum": 0}}},
    "network": {"type": "object", "properties": {"egress": {"enum": ["restricted", "open"]}, "ingress": {"enum": ["closed", "open"]}}},
    "controller": {"type": "object", "properties": {"stateStorageClass": {"type": "string"}}},
    "conductor": {"type": "object", "properties": {"internet": {"type": "object"}, "egress": {"type": ["array", "string"]}}},
    "admissionPolicy": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
  },
  "if": {"properties": {"mode": {"const": "multi"}}},
  "then": {
    "required": ["routerUrl", "routerKey"],
    "properties": {"routerUrl": {"minLength": 1}, "routerKey": {"minLength": 16}}
  }
}
