{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "shard",
    "blobgate",
    "stores"
  ],
  "properties": {
    "shard": {
      "type": "string",
      "pattern": "^[0-9]{1,16}$"
    },
    "blobgate": {
      "type": "object",
      "required": [
        "existingSecret",
        "rqliteUrl"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "rqliteUrl": {
          "type": "string",
          "pattern": "^https?://.+$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1
            },
            "shimPort": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "shards": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "adminToken": {
          "type": "string"
        },
        "sealKey": {
          "type": "string"
        }
      }
    },
    "stores": {
      "type": "object",
      "properties": {
        "garage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "default": {
              "type": "boolean"
            },
            "bucket": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]{2,62}$"
            },
            "capacityBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "endpoint",
              "bucket",
              "secretName"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              }
            }
          }
        },
        "mirrors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "bodySecret"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "bodySecret": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
