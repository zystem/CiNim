{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "shard", "rqliteUrl", "stores"],
  "properties": {
    "image": {"type": "object", "required": ["repository"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
    "shard": {"type": "string", "pattern": "^[0-9]{1,16}$"},
    "rqliteUrl": {"type": "string", "pattern": "^https?://.+$"},
    "replicas": {"type": "integer", "minimum": 1},
    "repairSeconds": {"type": "integer", "minimum": 1},
    "checkSeconds": {"type": "integer", "minimum": 1},
    "secrets": {"type": "object", "properties": {"existingSecret": {"type": "string"}, "shards": {"type": "object", "additionalProperties": {"type": "string"}},
                "adminToken": {"type": "string"}, "sealKey": {"type": "string"}, "nodeToken": {"type": "string"}}},
    "stores": {"type": "object", "properties": {
      "garage": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "default": {"type": "boolean"},
                 "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,62}$"}, "capacityBytes": {"type": "integer", "minimum": 1}}},
      "caddy": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "default": {"type": "boolean"},
                "nodes": {"type": "integer", "minimum": 1, "maximum": 4}, "minAcks": {"type": "integer", "minimum": 0, "maximum": 4},
                "image": {"type": "object", "properties": {"repository": {"type": "string"}, "tag": {"type": "string"}}}}},
      "external": {"type": "array", "items": {"type": "object", "required": ["name", "endpoint", "bucket", "secretName"],
                   "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "endpoint": {"type": "string", "pattern": "^https?://.+$"}}}}}},
    "shim": {"type": "object", "properties": {"port": {"type": "integer", "minimum": 0, "maximum": 65535}, "threads": {"type": "integer", "minimum": 1}}},
    "networkPolicy": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
  }
}
