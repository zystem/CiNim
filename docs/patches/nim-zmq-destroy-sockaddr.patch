# nim-zmq: =destroy must free the connection address string. Sent upstream as https://github.com/nim-lang/nim-zmq/pull/59 (with a regression test); until it is merged and the cinim branch is rebased, apply this to the installed package.
--- a/zmq/connections.nim	2026-10-02 21:49:19.443514046 +0300
+++ b/zmq/connections.nim	2026-10-02 21:49:19.465513999 +0300
@@ -230,6 +230,10 @@
         if ctx_term(x.context) != 0:
           echo("Error in closing ZMQ-context")
 
+    # A custom `=destroy` replaces the compiler's generated one, which is what destroys the object's fields: without this the
+    # `sockaddr` string of every connection ever made leaks (about 30 bytes each, found with heaptrack under -d:useMalloc)
+    `=destroy`(x.sockaddr)
+
   proc `=wasMoved`(x: var ZConnectionImpl) =
     x.alive = false
     x.socket = nil
